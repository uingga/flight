+// Terminal evidence, not an error string, authorizes publication of an interrupted round.
+export function validateParallelPartial(state, resultHashes) {
+    const requireValue = (ok, message) => { if (!ok) throw Error(message); };
+    const parallel = state.parallel;
+    requireValue(state.blocked === true && state.phase === 'blocked' && state.owner === 'parallel'
+        && parallel?.phase === 'collecting' && !state.partialPublication, 'partial round not stopped');
+    requireValue(['A', 'C'].every(worker => ['collected', 'stopped'].includes(parallel.states[worker])
+        && parallel.results[worker]?.cleanupConfirmed === true
+        && Number.isFinite(parallel.results[worker]?.terminalAt)
+        && /^[a-f0-9]{64}$/.test(resultHashes?.[worker] || '')
+        && parallel.results[worker].hash === resultHashes[worker]), 'terminal worker evidence missing');
+    const attempts = Object.values(state.attempts);
+    requireValue(attempts.every(attempt => ['success', 'miss', 'route_error', 'unknown'].includes(attempt.status)),
+        'pending or restricted attempt');
+    requireValue(attempts.filter(attempt => attempt.status === 'unknown')
+        .every(attempt => ['transient_error', 'route_error'].includes(attempt.reason)), 'unclassified interruption');
+    requireValue(['A', 'C'].every(worker => Number.isSafeInteger(state.used[worker])
+        && state.used[worker] >= 0 && state.used[worker] <= (worker === 'C' ? 250 : 200)
+        && state.used[worker] === attempts.filter(attempt => attempt.worker === worker).length)
+        && Object.keys(state.keys).length + Object.keys(state.rechecks || {}).length === attempts.length
+        && attempts.every(attempt => (attempt.recheck ? state.rechecks?.[attempt.key] : state.keys[attempt.key]) === attempt.requestId),
+    'partial ledger mismatch');
+    const current = attempts.filter(attempt => attempt.run === state.runs[attempt.worker]);
+    requireValue(current.some(attempt => attempt.status === 'unknown')
+        && current.some(attempt => attempt.status === 'success' && attempt.kind === 'search'), 'no verified partial prices');
+    return {
+        basis: 'parallel-terminal-proof', terminalHashes: { ...resultHashes },
+        successKeys: current.filter(attempt => attempt.status === 'success').map(attempt => attempt.key),
+        missKeys: current.filter(attempt => attempt.status === 'miss').map(attempt => attempt.key),
+    };
+}
